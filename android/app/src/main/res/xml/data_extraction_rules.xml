<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Only lightweight preferences travel with cloud backup / device
         transfer. The ledger database and backup files are EXCLUDED on
         purpose: use the in-app Backup & Restore flow instead. -->
    <cloud-backup>
        <include domain="sharedpref" path="."/>
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="."/>
    </device-transfer>
</data-extraction-rules>
